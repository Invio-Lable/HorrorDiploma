  m_Name: Latter_1
  m_EditorClassIdentifier: 
  letterText: "\u0417\u0430\u043F\u0438\u0441 04. \u0416\u043E\u0432\u0442\u0435\u043D\u044C.
    > \u042F \u043D\u0430\u0440\u0435\u0448\u0442\u0456 \u0437\u043D\u0430\u0439\u0448\u043E\u0432
    \u0446\u0435. \u041C\u0435\u0436\u0443 \u043C\u0456\u0436 \u0436\u0438\u0442\u0442\u044F\u043C
    \u0456 \u043D\u0435\u0431\u0443\u0442\u0442\u044F\u043C \u043C\u043E\u0436\u043D\u0430
    \u0441\u0442\u0435\u0440\u0442\u0438. \u0420\u043E\u0434\u0438\u043D\u0430 \u0444\u043E\u043D
    \u0414\u0435\u0440\u0456\u043D\u0433\u0456\u0432 \u0449\u0435\u0434\u0440\u043E
    \u0444\u0456\u043D\u0430\u043D\u0441\u0443\u0454 \u043C\u043E\u0457 \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F,
    \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0447\u0438\u0441\u044C \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438
    \u0441\u0432\u043E\u0433\u043E \u0441\u0438\u043D\u0430. \u0412\u043E\u043D\u0438
    \u043D\u0435 \u0440\u043E\u0437\u0443\u043C\u0456\u044E\u0442\u044C, \u0449\u043E
    \u044F \u0441\u0442\u043E\u044E \u043D\u0430 \u043F\u043E\u0440\u043E\u0437\u0456
    \u043A\u0443\u0434\u0438 \u0431\u0456\u043B\u044C\u0448\u043E\u0433\u043E \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0442\u044F.
    \u042F \u043D\u0430\u0432\u0447\u0438\u0432\u0441\u044F \u043F\u0435\u0440\u0435\u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0442\u0438
    \u043D\u0435\u0440\u0432\u043E\u0432\u0443 \u0441\u0438\u0441\u0442\u0435\u043C\u0443
    \u043D\u0430\u0432\u0456\u0442\u044C \u043F\u0456\u0441\u043B\u044F \u043F\u043E\u0432\u043D\u043E\u0433\u043E
    \u0432\u0456\u0434\u043C\u0438\u0440\u0430\u043D\u043D\u044F \u043A\u043B\u0456\u0442\u0438\u043D
    \u043C\u043E\u0437\u043A\u0443. \u0417\u0430\u0432\u0442\u0440\u0430 \u043C\u0438
    \u043F\u043E\u0447\u0438\u043D\u0430\u0454\u043C\u043E \u043F\u0435\u0440\u0448\u0456
    \u0442\u0435\u0441\u0442\u0438 \u043D\u0430 \"\u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u0446\u044F\u0445\"
    \u0456\u0437 \u043F\u0456\u0434\u0432\u0430\u043B\u0443. \u0421\u043C\u0435\u0440\u0442\u044C
    \u2014 \u0446\u0435 \u043B\u0438\u0448\u0435 \u0445\u0432\u043E\u0440\u043E\u0431\u0430,
    \u0456 \u044F \u0437\u043D\u0430\u0439\u0448\u043E\u0432 \u0432\u0456\u0434 \u043D\u0435\u0457
    \u043B\u0456\u043A\u0438."
