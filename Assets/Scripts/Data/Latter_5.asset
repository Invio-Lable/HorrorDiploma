  m_Name: Latter_5
  m_EditorClassIdentifier: 
  letterText: "\u0417\u0430\u043F\u0438\u0441 ???. \u041E\u0441\u0442\u0430\u043D\u043D\u0456\u0439.\n\u0422\u0435\u043C\u0440\u044F\u0432\u0430.
    \u041C\u0456\u0439 \u043B\u0456\u0445\u0442\u0430\u0440\u0438\u043A \u043C\u0430\u0439\u0436\u0435
    \u0441\u0456\u0432. \u042F \u0441\u0438\u0434\u0436\u0443 \u043F\u0456\u0434
    \u0441\u0442\u043E\u043B\u043E\u043C \u0456 \u043D\u0430\u0432\u0456\u0442\u044C
    \u0431\u043E\u044E\u0441\u044F \u0434\u0438\u0445\u0430\u0442\u0438. \u0412\u043E\u043D\u043E
    \u0431\u043B\u0443\u043A\u0430\u0454 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u043E\u043C.
    \u042F \u0447\u0443\u044E \u0439\u043E\u0433\u043E \u0432\u0430\u0436\u043A\u0456
    \u043A\u0440\u043E\u043A\u0438... \u0432\u043E\u043D\u043E \u0448\u0443\u043A\u0430\u0454.
    \u0412\u043E\u043D\u043E \u0441\u043B\u0456\u043F\u0435, \u0430\u043B\u0435 \u0447\u0443\u0454,
    \u044F\u043A \u0431'\u0454\u0442\u044C\u0441\u044F \u043C\u043E\u0454 \u0441\u0435\u0440\u0446\u0435
    \u0432\u0456\u0434 \u0441\u0442\u0440\u0430\u0445\u0443. \u0411\u0443\u0434\u044C
    \u043B\u0430\u0441\u043A\u0430, \u044F\u043A\u0449\u043E \u0442\u0438 \u0447\u0438\u0442\u0430\u0454\u0448
    \u0446\u0435... \u043D\u0435 \u0432\u0438\u0434\u0430\u0432\u0430\u0439 \u0430\u043D\u0456
    \u0437\u0432\u0443\u043A\u0443. \u0417\u0430\u043C\u0440\u0438. \u0412\u043E\u043D\u043E
    \u0432\u0436\u0435 \u0441\u0442\u043E\u0457\u0442\u044C \u0437\u0430 \u0434\u0432\u0435\u0440\u0438\u043C\u0430.
    \u042F \u0447\u0443\u044E, \u044F\u043A \u0432\u043E\u043D\u043E..."
